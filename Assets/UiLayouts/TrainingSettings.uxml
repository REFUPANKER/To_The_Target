<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UiLayouts/TrainingSettingsUi.uss?fileID=7433441132597879392&amp;guid=1cbe9de1349301547ae6b01f70104fc4&amp;type=3#TrainingSettingsUi"/>
    <ui:VisualElement name="" style="flex-grow: 1; margin-top: 30px; margin-right: 30px; margin-bottom: 30px; margin-left: 30px;">
        <ui:ScrollView name="trainingScrollView">
            <ui:VisualElement name="TrainingUiBody" style="flex-grow: 1; background-color: rgb(28, 28, 28); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(255, 120, 0); border-right-color: rgb(255, 120, 0); border-top-color: rgb(255, 120, 0); border-bottom-color: rgb(255, 120, 0); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; justify-content: flex-start; align-items: stretch; align-content: center; padding-top: 50px; padding-right: 50px; padding-bottom: 50px; padding-left: 50px;">
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-items: center;">
                    <ui:Button text="X" name="CloseButton" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/EXEPixelPerfect.ttf?fileID=12800000&amp;guid=782f6c62df863b74fbb41b0d20fdc22d&amp;type=3#EXEPixelPerfect&quot;); aspect-ratio: 1; height: 100%; font-size: 50px;"/>
                    <ui:Label text="Settings" name="" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/EXEPixelPerfect.ttf?fileID=12800000&amp;guid=782f6c62df863b74fbb41b0d20fdc22d&amp;type=3#EXEPixelPerfect&quot;); font-size: 70px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center; white-space: pre-wrap; flex-shrink: 1; flex-grow: 1;"/>
                    <ui:Button text="Save Settings" name="SaveButton" style="font-size: 50px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/EXEPixelPerfect.ttf?fileID=12800000&amp;guid=782f6c62df863b74fbb41b0d20fdc22d&amp;type=3#EXEPixelPerfect&quot;);"/>
                </ui:VisualElement>
                <ui:Label text="Mouse Settings" name="" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/EXEPixelPerfect.ttf?fileID=12800000&amp;guid=782f6c62df863b74fbb41b0d20fdc22d&amp;type=3#EXEPixelPerfect&quot;); font-size: 35px; color: rgb(255, 255, 255); -unity-font-style: normal; -unity-text-align: middle-center; white-space: pre-wrap;"/>
                <ui:Slider label="Mouse Sensitivity" value="100" high-value="500" fill="true" page-size="0.86" name="MouseSensSlider"/>
                <ui:Slider label="Aiming Sensitivity" value="15" high-value="500" fill="true" page-size="0.86" name="AimingSensSlider"/>
                <ui:Slider label="Sniper Sensitivity" value="15" high-value="500" fill="true" page-size="0.86" name="SniperSensSlider"/>
                <ui:Label text="Audio Settings" name="" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/EXEPixelPerfect.ttf?fileID=12800000&amp;guid=782f6c62df863b74fbb41b0d20fdc22d&amp;type=3#EXEPixelPerfect&quot;); font-size: 35px; color: rgb(255, 255, 255); -unity-font-style: normal; -unity-text-align: middle-center; white-space: pre-wrap;"/>
                <ui:Slider label="Master Volume" value="0.5" high-value="1" fill="true" page-size="0.86" name="MasterVolumeSlider"/>
                <ui:Slider label="Sound Effects" value="0.5" high-value="1" fill="true" page-size="0.86" name="SfxVolumeSlider"/>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
